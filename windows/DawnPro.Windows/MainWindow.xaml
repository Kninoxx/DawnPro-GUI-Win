<Window x:Class="DawnPro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moondrop Dawn Pro"
        Icon="Assets/DawnPro.ico"
        Width="520"
        MinWidth="450"
        MinHeight="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Moondrop Dawn Pro" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="Looking for the DAC…"
                       Margin="0,6,0,22" MinHeight="40" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

            <StackPanel x:Name="ControlsPanel" IsEnabled="False">
                <Grid Margin="0,0,0,4">
                    <Label x:Name="VolumeLabel" Content="DAC _volume" Target="{Binding ElementName=VolumeSlider}"
                           Padding="0" HorizontalAlignment="Left" />
                    <TextBlock x:Name="VolumeText" Text="—" HorizontalAlignment="Right" />
                </Grid>
                <Slider x:Name="VolumeSlider"
                        AutomationProperties.LabeledBy="{Binding ElementName=VolumeLabel}"
                        Minimum="0" Maximum="60" TickFrequency="1"
                        IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                        ValueChanged="OnDraftChanged" Margin="0,0,0,10" />

                <Label x:Name="GainLabel" Content="_Gain" Target="{Binding ElementName=GainBox}" Padding="0" />
                <ComboBox x:Name="GainBox" Margin="0,4,0,12"
                          AutomationProperties.LabeledBy="{Binding ElementName=GainLabel}"
                          SelectionChanged="OnDraftChanged" />

                <Label x:Name="LedLabel" Content="_Indicator LED" Target="{Binding ElementName=LedBox}" Padding="0" />
                <ComboBox x:Name="LedBox" Margin="0,4,0,12"
                          AutomationProperties.LabeledBy="{Binding ElementName=LedLabel}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectionChanged="OnDraftChanged" />

                <Label x:Name="FilterLabel" Content="Reconstruction _filter"
                       Target="{Binding ElementName=FilterBox}" Padding="0" />
                <ComboBox x:Name="FilterBox" Margin="0,4,0,20"
                          AutomationProperties.LabeledBy="{Binding ElementName=FilterLabel}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectionChanged="OnDraftChanged" />
            </StackPanel>

            <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,16">
                <Button x:Name="RefreshButton" Content="_Refresh" Click="OnRefresh"
                        MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="ApplyButton" Content="_Apply to DAC" Click="OnApply"
                        MinWidth="124" IsEnabled="False" />
            </WrapPanel>
            <Separator />
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="LoadButton" Content="_Load saved" Click="OnLoad"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="_Save locally" Click="OnSave"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="ImportButton" Content="I_mport JSON…" Click="OnImport" IsEnabled="False" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
